# ---- LLM Chat (Groq OpenAI-compatible chat endpoint) ----
# Without LLM_API_KEY, answers use the deterministic summary of computed results.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# ---- Embeddings (Google Gemini) ----
# Without EMBEDDING_API_KEY, document upload and documentation answers return a clear 503.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_MODEL=gemini-embedding-2
# Optional: specify output dimensions if downscaling via Matryoshka (e.g. 768 or 1536)
# EMBEDDING_DIMENSIONS=

# ---- Service ----
# Required. The placeholder 'change-me' disables the API.
DATASLEUTH_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_MB=20
MAX_DOCUMENT_MB=10
DATA_DIR=./data
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60
# Set to true ONLY behind a proxy that overwrites X-Forwarded-For (Render does).
TRUST_PROXY_HEADERS=false
