{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://datasleuth-qa0m.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://datasleuth-qa0m.onrender.com/health" },
    { "source": "/((?!api/|health).*)", "destination": "/index.html" }
  ]
}
